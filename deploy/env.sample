# Copy to .env and fill in. Secrets are real only when the operator sets them;
# every feature degrades to an explicit logged skip / 503 until its keys exist.
POSTGRES_DB=tradealert
POSTGRES_USER=tradealert
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://tradealert:@localhost:5432/tradealert
JWT_SECRET=
APP_BASE_URL=https://tradealert.me

# SES email — verified sender required before digest/alerts/verification mail sends.
AWS_REGION=
SES_VERIFIED_SENDER=alerts@tradealert.me

# Stripe — checkout, portal, and webhooks activate when these are set.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_free=
STRIPE_PRICE_ID_basic=
STRIPE_PRICE_ID_pro=
STRIPE_PRICE_ID_investor=
STRIPE_WEBHOOK_SECRET=

# Push (VAPID) and SMS (Twilio).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@tradealert.me
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Server-side key that encrypts stored webhook secrets; also the webhook
# signature HMAC secret material. Generate fresh per deployment.
WEBHOOK_SECRET_KEY=

# Sandbox only. 1 arms POST /api/billing/dev/preview for tier switches
# without Stripe; must be 0 on the production EC2 box.
BILLING_DEV_MODE=0